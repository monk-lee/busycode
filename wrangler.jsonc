{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "busycode-cli",
	"compatibility_date": "2026-05-28",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"pattern": "busycode.monklabs.dev",
			"custom_domain": true
		}
	]
}
