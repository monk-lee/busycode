{
	"name": "busycode",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"test:public-ready": "node --test scripts/verify-public-ready.test.mjs scripts/verify-cli-start-gates.test.mjs",
		"verify:public": "pnpm run build && pnpm run test:public-ready && node scripts/verify-public-ready.mjs"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"pnpm": {
		"overrides": {
			"esbuild": "0.28.1",
			"js-yaml": "4.2.0"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"eslint": "^10.5.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.5",
		"globals": "^17.11.0",
		"typescript": "~7.0.2",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"wrangler": "^4.127.1"
	}
}
